# Uhai Bora — Apache settings.
# Works when the app is the web root (Docker) and in a subfolder such as
# XAMPP's htdocs/uhai-bora-hms. Requires AllowOverride All (the default in the
# official php:*-apache image and in XAMPP).

Options -Indexes
DirectoryIndex index.php

# ---------------------------------------------------------------------------
# Never serve internal files. These rules work even without mod_rewrite.
# ---------------------------------------------------------------------------
<FilesMatch "(^\.|\.(sql|md|yml|yaml|ini|log|sh|lock|dist)$|^(Dockerfile|LICENSE|SECURITY)$)">
    Require all denied
</FilesMatch>
RedirectMatch 404 "/\.(?!well-known/)"

# ---------------------------------------------------------------------------
# Friendly 404s, legacy redirects and blocked folders (needs mod_rewrite).
# Internal rewrites to 404.php use relative paths, so they also work in a
# subfolder; 404.php always responds with HTTP status 404.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # The public pages moved from .html to .php: keep old links and bookmarks working.
    RewriteCond %{REQUEST_URI} ^(.*/)(index|services|about|contact|how-it-works|privacy|terms|cookies|accessibility)\.html$
    RewriteRule ^ %1%2.php [R=301,L]
    RewriteCond %{REQUEST_URI} ^(.*/)create-account\.php$
    RewriteRule ^ %1signup.php [R=301,L]

    # Source, configuration and database folders are never public.
    RewriteRule (^|/)\.(?!well-known/) 404.php [END]
    RewriteRule ^(includes|config|database|docker)(/|$) 404.php [END]
    RewriteRule \.(sql|md|yml|yaml|ini|log|sh|lock|dist)$ 404.php [END]
    RewriteRule ^(Dockerfile|LICENSE|SECURITY)$ 404.php [END]

    # Anything that does not exist gets the branded "page not found" page.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [END]

    # Folders without an index page (for example /css/) are treated as not found.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.php !-f
    RewriteRule ^ 404.php [END]
</IfModule>

# Fallback error pages when mod_rewrite is unavailable or Apache itself fails.
# These paths assume the app is the web root; in a subfolder, prefix them with
# the folder name (for example /uhai-bora-hms/404.php).
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php
ErrorDocument 500 /500.html

# ---------------------------------------------------------------------------
# Types, compression and caching. PHP pages set their own security headers
# (see includes/bootstrap.php); static files are versioned with ?v=…
# ---------------------------------------------------------------------------
AddType font/woff2 .woff2
AddType image/webp .webp
AddDefaultCharset UTF-8

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    <FilesMatch "\.(css|js|svg|woff2|webp|jpe?g|png)$">
        Header set X-Content-Type-Options "nosniff"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
